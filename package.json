{
  "name": "binance-menubar",
  "productName": "Binance Menubar",
  "version": "1.0.0",
  "description": "Binance position viewer for macOS menu bar",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && node scripts/wait-for-vite.js && NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run build:main && node --test tests/*.test.cjs",
    "test:ui": "node scripts/verify-ui.cjs",
    "start": "electron .",
    "watch:main": "tsc -p tsconfig.main.json --watch & tsc -p tsconfig.preload.json --watch",
    "package": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac"
  },
  "keywords": [
    "electron",
    "binance",
    "menubar",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "axe-core": "4.14.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "1.62.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "com.binance.menubar",
    "productName": "Binance Menubar",
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "type": "distribution"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "axios": "^1.6.2",
    "canvas": "^3.2.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.5",
    "lucide-vue-next": "^0.556.0",
    "vue": "^3.4.0"
  }
}
